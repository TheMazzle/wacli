<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.productfunction.wacli-health</string>

	<key>ProgramArguments</key>
	<array>
		<string>/Users/wjj/bin/wacli-health.sh</string>
	</array>

	<key>RunAtLoad</key>
	<true/>

	<!-- Elke 30 minuten. Het incident van 2026-06-17 bleef 68 dagen onopgemerkt;
	     met deze interval was het binnen een dag gemeld. -->
	<key>StartInterval</key>
	<integer>1800</integer>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>HOME</key>
		<string>/Users/wjj</string>
	</dict>

	<key>WorkingDirectory</key>
	<string>/Users/wjj</string>

	<key>StandardOutPath</key>
	<string>/Users/wjj/Library/Logs/Whatslack/wacli-health.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/wjj/Library/Logs/Whatslack/wacli-health.stdout.log</string>

	<key>Nice</key>
	<integer>10</integer>
</dict>
</plist>
